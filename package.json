{
  "name": "verity-mcp",
  "version": "1.0.0",
  "description": "MCP server for Verity skills. bearer-auth proxy",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --var COMMIT_SHA:$(git rev-parse HEAD) && bash scripts/multi-client-probe.sh https://mcp.verityskills.com",
    "deploy:preview": "wrangler deploy --env preview --var COMMIT_SHA:$(git rev-parse HEAD)",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-manifest": "bash scripts/check-manifest-schema.sh",
    "probe": "bash scripts/multi-client-probe.sh https://mcp.verityskills.com"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.53.1"
  }
}
