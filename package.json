{
  "name": "verity-mcp",
  "version": "1.0.0",
  "description": "MCP server for Verity skills. bearer-auth proxy",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --var COMMIT_SHA:$(git rev-parse HEAD) && bash scripts/multi-client-probe.sh https://mcp.verityskills.com",
    "deploy:preview": "wrangler deploy --env preview --var COMMIT_SHA:$(git rev-parse HEAD)",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-manifest": "bash scripts/check-manifest-schema.sh",
    "probe": "bash scripts/multi-client-probe.sh https://mcp.verityskills.com"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.78.0"
  }
}
